{
  // Gokski — Cloudflare Worker-ის პარამეტრები
  "name": "gokskii",
  "main": "src/worker.js",
  "compatibility_date": "2025-06-01",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS"
  },
  "ai": {
    "binding": "AI"
  },
  // პროგრესის, რანკის ცხრილისა და შეხსენებების საცავი
  "durable_objects": {
    "bindings": [{ "name": "STORE", "class_name": "GokskiStore" }]
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["GokskiStore"] }
  ],
  // ყოველ საათში: საღამოს შეხსენებები და კვირის ანგარიში
  "triggers": {
    "crons": ["0 * * * *"]
  },
  "workers_dev": true,
  "preview_urls": false
}
